    {
        "id": "a8e04f4ed24f643c",
        "type": "function",
        "z": "cb9036eb246fe66a",
        "name": "function 2",
        "func": "msg.topic = `\n    SELECT \n        a.ra, \n        a.nome, \n        MAX(p.data_hora) as ultima_hora_registro,\n        (SELECT COUNT(id) FROM alunos) as total_matriculados\n    FROM presencas p\n    JOIN alunos a ON p.aluno_id = a.id\n    WHERE DATE(p.data_hora) = CURRENT_DATE\n    GROUP BY a.ra, a.nome\n    ORDER BY ultima_hora_registro DESC;\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 1720,
        "wires": [
            [
                "dd6c700ba601f697"
            ]
        ]
    },
    {
        "id": "93e3246f62efb077",
        "type": "function",
        "z": "cb9036eb246fe66a",
        "name": "function 3",
        "func": "let registros = msg.payload || [];\n\nif (registros.length === 0) {\n    msg.payload = {\n        total_alunos: 0, \n        presentes: 0,\n        ausentes: 0,\n        ultimo_registro: \"--:--\",\n        taxa_presenca: 0,\n        alunos_presentes: []\n    };\n    return msg;\n}\n\nconst totalMatriculados = registros[0].total_matriculados;\n\nfunction formatarHora(dataString) {\n    if (!dataString) return \"--:--\";\n    let data = new Date(dataString); \n    \n    if (isNaN(data.getTime())) return \"--:--\"; \n    \n    let horas = data.getHours().toString().padStart(2, '0');\n    let minutos = data.getMinutes().toString().padStart(2, '0');\n    return `${horas}:${minutos}`;\n}\n\nlet alunosPresentes = registros.map(registro => {\n    return {\n        ra: registro.ra,\n        nome: registro.nome,\n        hora: formatarHora(registro.ultima_hora_registro)\n    };\n});\n\nlet presentes = alunosPresentes.length;\nlet ausentes = totalMatriculados - presentes;\nif (ausentes < 0) ausentes = 0;\n\nlet taxa = totalMatriculados > 0 ? Math.round((presentes / totalMatriculados) * 100) : 0;\n\nlet ultimoRegistro = alunosPresentes.length > 0 ? alunosPresentes[0].hora : \"--:--\";\n\nmsg.payload = {\n    total_alunos: totalMatriculados,\n    presentes: presentes,\n    ausentes: ausentes,\n    ultimo_registro: ultimoRegistro,\n    taxa_presenca: taxa,\n    alunos_presentes: alunosPresentes\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1080,
        "y": 1720,
