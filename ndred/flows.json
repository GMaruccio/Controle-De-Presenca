        "func": "msg.topic = \"SELECT a.ra, a.nome, TIME_FORMAT(p.data_hora, '%H:%i') AS hora, DATE_FORMAT(p.data_hora, '%d/%m/%Y') AS data FROM presencas p INNER JOIN alunos a ON a.id = p.aluno_id WHERE DATE(p.data_hora) = CURDATE() ORDER BY p.data_hora DESC\";\n\nreturn msg;",
