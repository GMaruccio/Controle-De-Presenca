        "id": "c66ed1f3a67209b3",
        "type": "function",
        "z": "cb9036eb246fe66a",
        "name": "validaRA",
        "func": "if (!msg.payload || !msg.payload.ra) {\n    msg.statusCode = 400;\n    msg.payload = {\n        sucesso: false,\n        mensagem: \"RA não informado\"\n    };\n    return msg;\n}\n\nconst ra = String(msg.payload.ra).trim();\n\nif (!/^[0-9]+$/.test(ra)) {\n    msg.statusCode = 400;\n    msg.payload = {\n        sucesso: false,\n        mensagem: \"RA inválido\"\n    };\n    return msg;\n}\n\nmsg.ra = ra;\n\nmsg.topic = \"SELECT id, ra, nome FROM alunos WHERE ra = '\" + ra + \"' LIMIT 1\";\nreturn msg;",
